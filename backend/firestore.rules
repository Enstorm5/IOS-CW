rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return isSignedIn() && request.auth.uid == userID;
    }

    function isReadableWall(wallID) {
      let wall = get(/databases/$(database)/documents/walls/$(wallID)).data;
      return wall.visibility == 'public' && wall.moderationStatus == 'active';
    }

    function isValidMessageContent(data, fields) {
      return data.contentType == 'text'
        ? data.keys().hasOnly(fields)
          && data.text is string && data.text.size() >= 1 && data.text.size() <= 280
        : data.contentType == 'drawing'
          && data.keys().hasOnly(fields.concat(['drawing']))
          && data.text == ''
          && data.drawing is string && data.drawing.size() >= 10 && data.drawing.size() <= 40000;
    }

    function isValidNewMessage(data) {
      let fields = ['authorID', 'authorName', 'text', 'contentType', 'color', 'sparkCount',
                    'normalizedX', 'normalizedY', 'moderationStatus', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields)
        && isValidMessageContent(data, fields)
        && data.authorID == request.auth.uid
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && data.color in ['magenta', 'mint', 'yellow', 'ink']
        && data.sparkCount == 0
        && data.normalizedX is number && data.normalizedX >= 0 && data.normalizedX <= 1
        && data.normalizedY is number && data.normalizedY >= 0 && data.normalizedY <= 1
        && data.moderationStatus == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidNewWall(data, wallID) {
      let fields = ['title', 'latitude', 'longitude', 'geohash', 'kind', 'visibility', 'moderationStatus',
                    'ownerID', 'anchorMode', 'anchorName', 'widthMeters', 'heightMeters', 'activeMapVersion',
                    'mapStorage', 'mapChunkCount', 'mapByteCount', 'mapChecksum', 'archiveVersion',
                    'captureOSVersion', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.ownerID == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 40
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.geohash is string && data.geohash.size() == 9
        && data.kind == 'community'
        && data.visibility == 'public'
        && data.moderationStatus == 'active'
        && data.anchorMode == 'worldMap'
        && data.anchorName == wallID
        && data.widthMeters is number && data.widthMeters >= 0.5 && data.widthMeters <= 3
        && data.heightMeters is number && data.heightMeters >= 0.5 && data.heightMeters <= 3
        && data.activeMapVersion == 1
        && data.mapStorage == 'firestoreChunks'
        && data.mapChunkCount is int && data.mapChunkCount >= 1 && data.mapChunkCount <= 24
        && data.mapByteCount is int && data.mapByteCount > 0 && data.mapByteCount <= 20971520
        && data.mapChecksum is string && data.mapChecksum.size() == 64
        && data.archiveVersion == 1
        && data.captureOSVersion is string && data.captureOSVersion.size() <= 20
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && get(/databases/$(database)/documents/walls/$(wallID)/mapChunks/0).data.ownerID == request.auth.uid;
    }

    function isValidMapChunk(data, chunkID) {
      return data.keys().hasOnly(['index', 'version', 'ownerID', 'data'])
        && data.keys().hasAll(['index', 'version', 'ownerID', 'data'])
        && data.ownerID == request.auth.uid
        && data.index is int && data.index >= 0 && data.index < 24
        && chunkID == string(data.index)
        && data.version == 1
        && data.data is bytes && data.data.size() <= 900000;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'avatarPreset', 'interests', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && data.bio is string && data.bio.size() <= 160
        && data.avatarPreset in ['magenta', 'mint', 'sunny', 'night']
        && data.interests is list
        && data.interests.size() >= 1 && data.interests.size() <= 8;
    }

    function today() {
      return math.floor((request.time.toMillis() + 19800000) / 86400000);
    }

    function statsFields() {
      return ['balance', 'lifetimeXP', 'discoveryCount', 'streakDays', 'longestStreak', 'lastQualifiedDay',
              'dailyDay', 'dailyDiscoveries', 'questsClaimed', 'lastDiscoveryWallID', 'lastClaimID',
              'wallsPublished', 'lastPublishedWallID'];
    }

    function userPath(userID) {
      return /databases/$(database)/documents/users/$(userID);
    }

    function messagePath(wallID, messageID) {
      return /databases/$(database)/documents/walls/$(wallID)/messages/$(messageID);
    }

    function mySparkPath(wallID, messageID) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/sparks/$(wallID + '_' + messageID);
    }

    function isAuthorTextEdit(before, after) {
      return before.authorID == request.auth.uid
        && before.contentType == 'text'
        && after.diff(before).affectedKeys().hasOnly(['text', 'updatedAt'])
        && after.text is string && after.text.size() >= 1 && after.text.size() <= 280
        && after.updatedAt == request.time;
    }

    function isSparkChange(wallID, messageID, before, after) {
      return before.authorID != request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['sparkCount'])
        && ((after.sparkCount == before.sparkCount + 1
              && !exists(mySparkPath(wallID, messageID))
              && existsAfter(mySparkPath(wallID, messageID)))
            || (after.sparkCount == before.sparkCount - 1
              && exists(mySparkPath(wallID, messageID))
              && !existsAfter(mySparkPath(wallID, messageID))));
    }

    function isFreshStats(data) {
      return data.keys().hasOnly(statsFields()) && data.keys().hasAll(statsFields())
        && data.balance == 0 && data.lifetimeXP == 0 && data.discoveryCount == 0
        && data.streakDays == 0 && data.longestStreak == 0 && data.lastQualifiedDay == 0
        && data.dailyDay == 0 && data.dailyDiscoveries == 0 && data.questsClaimed == 0
        && data.lastDiscoveryWallID == '' && data.lastClaimID == ''
        && data.wallsPublished == 0 && data.lastPublishedWallID == '';
    }

    function expectedStreak(before, day) {
      return before.lastQualifiedDay == day ? before.streakDays
        : (before.lastQualifiedDay == day - 1 ? before.streakDays + 1 : 1);
    }

    function isDiscoveryUpdate(userID, before, after) {
      let day = today();
      let wallID = after.lastDiscoveryWallID;
      let streak = expectedStreak(before, day);
      return wallID is string && wallID.size() > 0
        && !exists(/databases/$(database)/documents/users/$(userID)/discoveries/$(wallID))
        && existsAfter(/databases/$(database)/documents/users/$(userID)/discoveries/$(wallID))
        && after.balance == before.balance + 10
        && after.lifetimeXP == before.lifetimeXP + 10
        && after.discoveryCount == before.discoveryCount + 1
        && after.dailyDay == day
        && after.dailyDiscoveries == (before.dailyDay == day ? before.dailyDiscoveries + 1 : 1)
        && after.streakDays == streak
        && after.longestStreak == (before.longestStreak > streak ? before.longestStreak : streak)
        && after.lastQualifiedDay == day
        && after.questsClaimed == before.questsClaimed
        && after.lastClaimID == before.lastClaimID
        && publishFieldsUnchanged(before, after);
    }

    function publishFieldsUnchanged(before, after) {
      return after.wallsPublished == before.get('wallsPublished', 0)
        && after.lastPublishedWallID == before.get('lastPublishedWallID', '');
    }

    function isWallPublishDebit(before, after) {
      let wallID = after.lastPublishedWallID;
      return wallID is string && wallID.size() > 0
        && wallID != before.get('lastPublishedWallID', '')
        && !exists(/databases/$(database)/documents/walls/$(wallID))
        && existsAfter(/databases/$(database)/documents/walls/$(wallID))
        && before.balance >= 50
        && after.balance == before.balance - 50
        && after.wallsPublished == before.get('wallsPublished', 0) + 1
        && after.lifetimeXP == before.lifetimeXP
        && after.discoveryCount == before.discoveryCount
        && after.streakDays == before.streakDays
        && after.longestStreak == before.longestStreak
        && after.lastQualifiedDay == before.lastQualifiedDay
        && after.dailyDay == before.dailyDay
        && after.dailyDiscoveries == before.dailyDiscoveries
        && after.questsClaimed == before.questsClaimed
        && after.lastDiscoveryWallID == before.lastDiscoveryWallID
        && after.lastClaimID == before.lastClaimID;
    }

    function isOwnerRename(before, after) {
      return before.ownerID == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['title', 'updatedAt'])
        && after.title is string && after.title.size() >= 2 && after.title.size() <= 40
        && after.updatedAt == request.time;
    }

    function isQuestClaimUpdate(userID, before, after) {
      let day = today();
      let claimID = string(day) + '_readFive';
      return after.lastClaimID == claimID
        && before.lastClaimID != claimID
        && existsAfter(/databases/$(database)/documents/users/$(userID)/questClaims/$(claimID))
        && before.dailyDay == day && before.dailyDiscoveries >= 5
        && after.balance == before.balance + 40
        && after.lifetimeXP == before.lifetimeXP + 40
        && after.questsClaimed == before.questsClaimed + 1
        && after.discoveryCount == before.discoveryCount
        && after.dailyDay == before.dailyDay
        && after.dailyDiscoveries == before.dailyDiscoveries
        && after.streakDays == before.streakDays
        && after.longestStreak == before.longestStreak
        && after.lastQualifiedDay == before.lastQualifiedDay
        && after.lastDiscoveryWallID == before.lastDiscoveryWallID
        && publishFieldsUnchanged(before, after);
    }

    function isAwardRecord(data) {
      return data.keys().hasOnly(['day', 'createdAt']) && data.keys().hasAll(['day', 'createdAt'])
        && data.day == today()
        && data.createdAt == request.time;
    }

    function crewPath(crewID) {
      return /databases/$(database)/documents/crews/$(crewID);
    }

    function crewMemberPath(crewID, userID) {
      return /databases/$(database)/documents/crews/$(crewID)/members/$(userID);
    }

    function crewMembershipPath(userID) {
      return /databases/$(database)/documents/crewMemberships/$(userID);
    }

    function isCrewMember(crewID) {
      return isSignedIn() && exists(crewMemberPath(crewID, request.auth.uid));
    }

    function isValidNewCrew(data, crewID) {
      let fields = ['name', 'inviteCode', 'ownerID', 'memberCount', 'lastMemberID', 'createdAt'];
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 30
        && data.inviteCode is string && data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && data.ownerID == request.auth.uid
        && data.memberCount == 1
        && data.lastMemberID == request.auth.uid
        && data.createdAt == request.time
        && existsAfter(crewMemberPath(crewID, request.auth.uid))
        && getAfter(/databases/$(database)/documents/crewInvites/$(data.inviteCode)).data.crewID == crewID;
    }

    function isCrewJoin(crewID, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['memberCount', 'lastMemberID'])
        && after.memberCount == before.memberCount + 1
        && after.memberCount <= 20
        && after.lastMemberID == request.auth.uid
        && !exists(crewMemberPath(crewID, request.auth.uid))
        && existsAfter(crewMemberPath(crewID, request.auth.uid));
    }

    function isCrewLeave(crewID, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['memberCount', 'lastMemberID', 'ownerID'])
        && after.memberCount == before.memberCount - 1
        && after.lastMemberID == request.auth.uid
        && exists(crewMemberPath(crewID, request.auth.uid))
        && !existsAfter(crewMemberPath(crewID, request.auth.uid))
        && (before.ownerID == request.auth.uid
            ? after.ownerID != request.auth.uid && existsAfter(crewMemberPath(crewID, after.ownerID))
            : after.ownerID == before.ownerID);
    }

    function isCrewRemoval(crewID, before, after) {
      return after.diff(before).affectedKeys().hasOnly(['memberCount', 'lastMemberID'])
        && before.ownerID == request.auth.uid
        && after.memberCount == before.memberCount - 1
        && after.lastMemberID != request.auth.uid
        && exists(crewMemberPath(crewID, after.lastMemberID))
        && !existsAfter(crewMemberPath(crewID, after.lastMemberID));
    }

    function isValidNewCrewMember(crewID, data) {
      let fields = ['displayName', 'avatarPreset', 'inviteCode', 'joinedAt'];
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && data.displayName == profile.displayName
        && data.avatarPreset == profile.avatarPreset
        && data.inviteCode == getAfter(crewPath(crewID)).data.inviteCode
        && data.joinedAt == request.time
        && getAfter(crewPath(crewID)).data.lastMemberID == request.auth.uid
        && getAfter(crewMembershipPath(request.auth.uid)).data.crewID == crewID;
    }

    match /users/{userID} {
      allow read: if isOwner(userID);
      allow create: if isOwner(userID) && isFreshStats(request.resource.data);
      allow update: if isOwner(userID)
        && request.resource.data.keys().hasOnly(statsFields())
        && request.resource.data.keys().hasAll(statsFields())
        && (isDiscoveryUpdate(userID, resource.data, request.resource.data)
            || isQuestClaimUpdate(userID, resource.data, request.resource.data)
            || isWallPublishDebit(resource.data, request.resource.data));
      allow delete: if false;

      match /discoveries/{wallID} {
        allow read: if isOwner(userID);
        allow create: if isOwner(userID)
          && isAwardRecord(request.resource.data)
          && isReadableWall(wallID)
          && getAfter(userPath(userID)).data.lastDiscoveryWallID == wallID
          && getAfter(userPath(userID)).data.discoveryCount == get(userPath(userID)).data.discoveryCount + 1;
        allow update, delete: if false;
      }

      match /sparks/{sparkID} {
        allow read: if isOwner(userID);
        allow create: if isOwner(userID)
          && request.resource.data.keys().hasOnly(['wallID', 'messageID', 'createdAt'])
          && request.resource.data.keys().hasAll(['wallID', 'messageID', 'createdAt'])
          && sparkID == request.resource.data.wallID + '_' + request.resource.data.messageID
          && request.resource.data.createdAt == request.time
          && getAfter(messagePath(request.resource.data.wallID, request.resource.data.messageID)).data.sparkCount
             == get(messagePath(request.resource.data.wallID, request.resource.data.messageID)).data.sparkCount + 1;
        allow delete: if isOwner(userID)
          && getAfter(messagePath(resource.data.wallID, resource.data.messageID)).data.sparkCount
             == get(messagePath(resource.data.wallID, resource.data.messageID)).data.sparkCount - 1;
        allow update: if false;
      }

      match /questClaims/{claimID} {
        allow read: if isOwner(userID);
        allow create: if isOwner(userID)
          && isAwardRecord(request.resource.data)
          && claimID == string(today()) + '_readFive'
          && getAfter(userPath(userID)).data.lastClaimID == claimID
          && getAfter(userPath(userID)).data.questsClaimed == get(userPath(userID)).data.questsClaimed + 1;
        allow update, delete: if false;
      }
    }

    match /{path=**}/messages/{messageID} {
      allow read: if isSignedIn() && resource.data.authorID == request.auth.uid;
    }

    match /profiles/{userID} {
      allow read: if isSignedIn();
      allow create: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userID);
    }

    match /crewInvites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['crewID', 'crewName'])
        && request.resource.data.keys().hasAll(['crewID', 'crewName'])
        && !exists(crewPath(request.resource.data.crewID))
        && getAfter(crewPath(request.resource.data.crewID)).data.ownerID == request.auth.uid
        && getAfter(crewPath(request.resource.data.crewID)).data.inviteCode == code
        && getAfter(crewPath(request.resource.data.crewID)).data.name == request.resource.data.crewName;
      allow update: if false;
      allow delete: if isCrewMember(resource.data.crewID)
        && !existsAfter(crewPath(resource.data.crewID));
    }

    match /crewMemberships/{userID} {
      allow read: if isOwner(userID);
      allow create: if isOwner(userID)
        && request.resource.data.keys().hasOnly(['crewID', 'joinedAt'])
        && request.resource.data.keys().hasAll(['crewID', 'joinedAt'])
        && request.resource.data.joinedAt == request.time
        && existsAfter(crewMemberPath(request.resource.data.crewID, userID));
      allow update: if false;
      allow delete: if isOwner(userID)
        && !existsAfter(crewMemberPath(resource.data.crewID, userID));
    }

    match /crews/{crewID} {
      allow read: if isCrewMember(crewID);
      allow create: if isSignedIn() && isValidNewCrew(request.resource.data, crewID);
      allow update: if isSignedIn()
        && (isCrewJoin(crewID, resource.data, request.resource.data)
            || isCrewLeave(crewID, resource.data, request.resource.data)
            || isCrewRemoval(crewID, resource.data, request.resource.data));
      allow delete: if isCrewMember(crewID)
        && resource.data.memberCount == 1
        && !existsAfter(crewMemberPath(crewID, request.auth.uid));

      match /members/{memberID} {
        allow read: if isCrewMember(crewID);
        allow create: if isOwner(memberID) && isValidNewCrewMember(crewID, request.resource.data);
        allow update: if false;
        allow delete: if isSignedIn()
          && (memberID == request.auth.uid
                ? !existsAfter(crewMembershipPath(memberID))
                : get(crewPath(crewID)).data.ownerID == request.auth.uid)
          && (!existsAfter(crewPath(crewID))
              || getAfter(crewPath(crewID)).data.lastMemberID == memberID);
      }
    }

    match /walls/{wallID} {
      allow read: if isSignedIn()
        && resource.data.visibility == 'public'
        && resource.data.moderationStatus == 'active';
      allow create: if isSignedIn()
        && isValidNewWall(request.resource.data, wallID)
        && getAfter(userPath(request.auth.uid)).data.lastPublishedWallID == wallID
        && getAfter(userPath(request.auth.uid)).data.balance == get(userPath(request.auth.uid)).data.balance - 50;
      allow update: if isSignedIn() && isOwnerRename(resource.data, request.resource.data);
      allow delete: if isSignedIn() && resource.data.ownerID == request.auth.uid;

      match /mapChunks/{chunkID} {
        allow read: if isSignedIn()
          && (resource.data.ownerID == request.auth.uid || isReadableWall(wallID));
        allow create: if isSignedIn()
          && isValidMapChunk(request.resource.data, chunkID)
          && !exists(/databases/$(database)/documents/walls/$(wallID));
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.ownerID == request.auth.uid;
      }

      match /messages/{messageID} {
        allow read: if isSignedIn()
          && resource.data.moderationStatus == 'active'
          && isReadableWall(wallID);
        allow create: if isSignedIn()
          && isReadableWall(wallID)
          && isValidNewMessage(request.resource.data);
        allow update: if isSignedIn()
          && isReadableWall(wallID)
          && resource.data.moderationStatus == 'active'
          && (isAuthorTextEdit(resource.data, request.resource.data)
              || isSparkChange(wallID, messageID, resource.data, request.resource.data));
        allow delete: if isSignedIn() && resource.data.authorID == request.auth.uid;
      }
    }
  }
}
