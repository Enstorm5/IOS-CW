rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userID) {
      return request.auth != null && request.auth.uid == userID;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'avatarPreset', 'interests', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && data.bio is string && data.bio.size() <= 160
        && data.avatarPreset in ['magenta', 'mint', 'sunny', 'night']
        && data.interests is list
        && data.interests.size() >= 1 && data.interests.size() <= 8;
    }

    match /profiles/{userID} {
      allow read: if request.auth != null;
      allow create: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userID);
    }
  }
}
