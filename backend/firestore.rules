rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return isSignedIn() && request.auth.uid == userID;
    }

    function isReadableWall(wallID) {
      let wall = get(/databases/$(database)/documents/walls/$(wallID)).data;
      return wall.visibility == 'public' && wall.moderationStatus == 'active';
    }

    function isValidMessageContent(data, fields) {
      return data.contentType == 'text'
        ? data.keys().hasOnly(fields)
          && data.text is string && data.text.size() >= 1 && data.text.size() <= 280
        : data.contentType == 'drawing'
          && data.keys().hasOnly(fields.concat(['drawing']))
          && data.text == ''
          && data.drawing is string && data.drawing.size() >= 10 && data.drawing.size() <= 40000;
    }

    function isValidNewMessage(data) {
      let fields = ['authorID', 'authorName', 'text', 'contentType', 'color', 'sparkCount',
                    'normalizedX', 'normalizedY', 'moderationStatus', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields)
        && isValidMessageContent(data, fields)
        && data.authorID == request.auth.uid
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && data.color in ['magenta', 'mint', 'yellow', 'ink']
        && data.sparkCount == 0
        && data.normalizedX is number && data.normalizedX >= 0 && data.normalizedX <= 1
        && data.normalizedY is number && data.normalizedY >= 0 && data.normalizedY <= 1
        && data.moderationStatus == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidNewWall(data, wallID) {
      let fields = ['title', 'latitude', 'longitude', 'geohash', 'kind', 'visibility', 'moderationStatus',
                    'ownerID', 'anchorMode', 'anchorName', 'widthMeters', 'heightMeters', 'activeMapVersion',
                    'mapStorage', 'mapChunkCount', 'mapByteCount', 'mapChecksum', 'archiveVersion',
                    'captureOSVersion', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.ownerID == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 40
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && data.geohash is string && data.geohash.size() == 9
        && data.kind == 'community'
        && data.visibility == 'public'
        && data.moderationStatus == 'active'
        && data.anchorMode == 'worldMap'
        && data.anchorName == wallID
        && data.widthMeters is number && data.widthMeters >= 0.5 && data.widthMeters <= 3
        && data.heightMeters is number && data.heightMeters >= 0.5 && data.heightMeters <= 3
        && data.activeMapVersion == 1
        && data.mapStorage == 'firestoreChunks'
        && data.mapChunkCount is int && data.mapChunkCount >= 1 && data.mapChunkCount <= 24
        && data.mapByteCount is int && data.mapByteCount > 0 && data.mapByteCount <= 20971520
        && data.mapChecksum is string && data.mapChecksum.size() == 64
        && data.archiveVersion == 1
        && data.captureOSVersion is string && data.captureOSVersion.size() <= 20
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && get(/databases/$(database)/documents/walls/$(wallID)/mapChunks/0).data.ownerID == request.auth.uid;
    }

    function isValidMapChunk(data, chunkID) {
      return data.keys().hasOnly(['index', 'version', 'ownerID', 'data'])
        && data.keys().hasAll(['index', 'version', 'ownerID', 'data'])
        && data.ownerID == request.auth.uid
        && data.index is int && data.index >= 0 && data.index < 24
        && chunkID == string(data.index)
        && data.version == 1
        && data.data is bytes && data.data.size() <= 900000;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'avatarPreset', 'interests', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && data.bio is string && data.bio.size() <= 160
        && data.avatarPreset in ['magenta', 'mint', 'sunny', 'night']
        && data.interests is list
        && data.interests.size() >= 1 && data.interests.size() <= 8;
    }

    match /profiles/{userID} {
      allow read: if isSignedIn();
      allow create: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userID);
    }

    match /walls/{wallID} {
      allow read: if isSignedIn()
        && resource.data.visibility == 'public'
        && resource.data.moderationStatus == 'active';
      allow create: if isSignedIn() && isValidNewWall(request.resource.data, wallID);
      allow update, delete: if false;

      match /mapChunks/{chunkID} {
        allow read: if isSignedIn()
          && (resource.data.ownerID == request.auth.uid || isReadableWall(wallID));
        allow create: if isSignedIn()
          && isValidMapChunk(request.resource.data, chunkID)
          && !exists(/databases/$(database)/documents/walls/$(wallID));
        allow update, delete: if false;
      }

      match /messages/{messageID} {
        allow read: if isSignedIn()
          && resource.data.moderationStatus == 'active'
          && isReadableWall(wallID);
        allow create: if isSignedIn()
          && isReadableWall(wallID)
          && isValidNewMessage(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
