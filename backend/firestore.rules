rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return isSignedIn() && request.auth.uid == userID;
    }

    function isReadableWall(wallID) {
      let wall = get(/databases/$(database)/documents/walls/$(wallID)).data;
      return wall.visibility == 'public' && wall.moderationStatus == 'active';
    }

    function isValidNewMessage(data) {
      let fields = ['authorID', 'authorName', 'text', 'contentType', 'color', 'sparkCount',
                    'normalizedX', 'normalizedY', 'moderationStatus', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(fields)
        && data.keys().hasAll(fields)
        && data.authorID == request.auth.uid
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 280
        && data.contentType == 'text'
        && data.color in ['magenta', 'mint', 'yellow', 'ink']
        && data.sparkCount == 0
        && data.normalizedX is number && data.normalizedX >= 0 && data.normalizedX <= 1
        && data.normalizedY is number && data.normalizedY >= 0 && data.normalizedY <= 1
        && data.moderationStatus == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidProfile(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'avatarPreset', 'interests', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 2 && data.displayName.size() <= 30
        && data.bio is string && data.bio.size() <= 160
        && data.avatarPreset in ['magenta', 'mint', 'sunny', 'night']
        && data.interests is list
        && data.interests.size() >= 1 && data.interests.size() <= 8;
    }

    match /profiles/{userID} {
      allow read: if isSignedIn();
      allow create: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userID)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userID);
    }

    match /walls/{wallID} {
      allow read: if isSignedIn()
        && resource.data.visibility == 'public'
        && resource.data.moderationStatus == 'active';
      allow write: if false;

      match /messages/{messageID} {
        allow read: if isSignedIn()
          && resource.data.moderationStatus == 'active'
          && isReadableWall(wallID);
        allow create: if isSignedIn()
          && isReadableWall(wallID)
          && isValidNewMessage(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
